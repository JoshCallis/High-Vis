<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.josh.winlink</string>

    <!-- The Mac end of max/winlink: Windows' agent dials in on 10.211.55.2:27121 and
         reports its text-field focus (Karabiner variable vm_text_field); goto_app.sh
         asks it for File Explorer over /tmp/winlink.sock. Install: max/winlink/install.sh. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-S</string>
        <string>/Users/josh/Code/Scripts/max/winlink/winlink.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/tmp/winlink.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/winlink.log</string>
</dict>
</plist>
